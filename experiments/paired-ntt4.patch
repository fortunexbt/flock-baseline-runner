+    #[test]
+    fn paired_fused4_matches_scalar_at_varied_strides_and_tails() {
+        let mut next = rng(0x9cd7_f421_66a1_b333);
+        for stride in [1, 2, 3, 8, 128] {
+            for lanes in [1usize, 3, 4, 7, 8, 16, 60, 64, 65] {
+                for active in [0, lanes / 2, lanes.saturating_sub(1), lanes] {
+                    let mut got: Vec<F128> = (0..16 * stride * lanes).map(|_| next()).collect();
+                    let mut expected = got.clone();
+                    let tw: [F128; 15] = core::array::from_fn(|_| next());
+                    let row = stride - 1;
+                    for lane in 0..active {
+                        let mut values: [F128; 16] =
+                            core::array::from_fn(|i| expected[(i * stride + row) * lanes + lane]);
+                        super::super::portable::butterfly_fused_4layer(&mut values, &tw);
+                        for i in 0..16 {
+                            expected[(i * stride + row) * lanes + lane] = values[i];
+                        }
+                    }
+                    // SAFETY: the vector contains all sixteen addressed row
+                    // groups, the active prefix is bounded, and rows are disjoint.
+                    unsafe {
+                        butterfly_fused_4layer_row(
+                            got.as_mut_ptr(),
+                            stride,
+                            lanes,
+                            active,
+                            row,
+                            &tw,
+                        );
+                    }
+                    assert_eq!(
+                        got, expected,
+                        "stride={stride} lanes={lanes} active={active}"
+                    );
+                }
+            }
         }
