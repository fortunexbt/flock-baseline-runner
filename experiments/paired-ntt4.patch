+/// Two independent split-twiddle butterflies with bounded register liveness.
+///
+/// The split product is unchanged: `lo = v.lo*t.lo ^ v.hi*t_x64.lo`,
+/// `hi = v.lo*t.hi ^ v.hi*t_x64.hi`, then `lo ^ (hi << 64) ^
+/// clmul(hi.high, 0x87)`. Each low accumulator also includes its original
+/// upper butterfly input. The final lower output is the original lower
+/// input XOR the new upper output.
+///
+/// The fixed instruction block prevents the compiler from scheduling all
+/// eight independent products in one transform layer simultaneously and
+/// spilling their many intermediate values. Two products expose independent
+/// work while requiring only six temporary vector registers. No memory is
+/// read or written by the assembly; all operands and clobbers are explicit.
+///
+/// # Safety
+/// The enclosing architecture module requires AVX-512F and VPCLMULQDQ.
+/// Each twiddle pair must contain `(t, t*x^64 mod p)` in all four lanes.
+#[inline(always)]
+unsafe fn butterfly_pair_split(
+    ta: TwX4,
+    tb: TwX4,
+    mut ua: core::arch::x86_64::__m512i,
+    mut va: core::arch::x86_64::__m512i,
+    mut ub: core::arch::x86_64::__m512i,
+    mut vb: core::arch::x86_64::__m512i,
+) -> (
+    core::arch::x86_64::__m512i,
+    core::arch::x86_64::__m512i,
+    core::arch::x86_64::__m512i,
+    core::arch::x86_64::__m512i,
+) {
+    use core::arch::x86_64::*;
+    unsafe {
+        let poly = _mm512_set1_epi64(0x87);
+        // Typed scratch outputs are intentional. They give the compiler
+        // concrete SIMD types as well as explicit early-clobber registers.
+        let (la, lb, ha, hb, xa, xb): (__m512i, __m512i, __m512i, __m512i, __m512i, __m512i);
+        core::arch::asm!(
+            "vpclmulqdq {la:z}, {va}, {ta}, 0",
+            "vpclmulqdq {xa:z}, {va}, {ca}, 1",
+            "vpclmulqdq {lb:z}, {vb}, {tb}, 0",
+            "vpclmulqdq {xb:z}, {vb}, {cb}, 1",
+            "vpternlogq {la:z}, {xa:z}, {ua}, 0x96",
+            "vpternlogq {lb:z}, {xb:z}, {ub}, 0x96",
+            "vpclmulqdq {ha:z}, {va}, {ta}, 16",
+            "vpclmulqdq {xa:z}, {va}, {ca}, 17",
+            "vpclmulqdq {hb:z}, {vb}, {tb}, 16",
+            "vpclmulqdq {xb:z}, {vb}, {cb}, 17",
+            "vpxorq {ha:z}, {ha:z}, {xa:z}",
+            "vpxorq {hb:z}, {hb:z}, {xb:z}",
+            "vpclmulqdq {xa:z}, {ha:z}, {poly}, 1",
+            "vpclmulqdq {xb:z}, {hb:z}, {poly}, 1",
+            // Within each 256-bit half, select qwords [0,0,2,2],
+            // then zero the even lanes. This implements each 128-bit
+            // left shift by 64 using AVX-512F alone (no AVX-512BW).
+            "vpermq {ua}{{{shift_mask}}}{{z}}, {ha:z}, 0xa0",
+            "vpermq {ub}{{{shift_mask}}}{{z}}, {hb:z}, 0xa0",
+            "vpternlogq {ua}, {la:z}, {xa:z}, 0x96",
+            "vpternlogq {ub}, {lb:z}, {xb:z}, 0x96",
+            "vpxorq {va}, {va}, {ua}",
+            "vpxorq {vb}, {vb}, {ub}",
+            ua=inout(zmm_reg) ua, va=inout(zmm_reg) va,
+            ub=inout(zmm_reg) ub, vb=inout(zmm_reg) vb,
+            ta=in(zmm_reg) ta.0, ca=in(zmm_reg) ta.1,
+            tb=in(zmm_reg) tb.0, cb=in(zmm_reg) tb.1,
+            poly=in(zmm_reg) poly, shift_mask=in(kreg) 0xaa_u8,
+            la=out(zmm_reg) la,lb=out(zmm_reg) lb,ha=out(zmm_reg) ha,hb=out(zmm_reg) hb,
+            xa=out(zmm_reg) xa,xb=out(zmm_reg) xb,
+            options(pure,nomem,nostack,preserves_flags)
+        );
+        let _ = (la, lb, ha, hb, xa, xb);
+    }
+    (ua, va, ub, vb)
 }
 
