+    #[test]
+    fn paired_split_butterflies_match_scalar_field_arithmetic() {
+        use core::arch::x86_64::{__m512i, _mm512_loadu_si512, _mm512_storeu_si512};
+        let mut next = rng(0x7f41_06e2_5823_91ad);
+        for case in 0..2048usize {
+            let ta = if case == 0 {
+                F128::ZERO
+            } else if case == 1 {
+                F128::ONE
+            } else {
+                next()
+            };
+            let tb = if case == 2 {
+                F128::ZERO
+            } else if case == 3 {
+                F128::ONE
+            } else {
+                next()
+            };
+            let original: [[F128; 4]; 4] =
+                core::array::from_fn(|_| core::array::from_fn(|_| next()));
+            let mut got = [[F128::ZERO; 4]; 4];
+            // SAFETY: this test is compiled only in the feature-gated x86
+            // module; each array holds exactly four initialized F128 values.
+            unsafe {
+                let args: [__m512i; 4] =
+                    core::array::from_fn(|i| _mm512_loadu_si512(original[i].as_ptr().cast()));
+                let (a, b, c, d) = butterfly_pair_split(
+                    tw_x4::<false, true>(ta),
+                    tw_x4::<false, true>(tb),
+                    args[0],
+                    args[1],
+                    args[2],
+                    args[3],
+                );
+                for (i, value) in [a, b, c, d].into_iter().enumerate() {
+                    _mm512_storeu_si512(got[i].as_mut_ptr().cast(), value);
+                }
+            }
+            for lane in 0..4 {
+                let ua = original[0][lane] + ta * original[1][lane];
+                let ub = original[2][lane] + tb * original[3][lane];
+                assert_eq!(got[0][lane], ua, "upper A case={case} lane={lane}");
+                assert_eq!(
+                    got[1][lane],
+                    original[1][lane] + ua,
+                    "lower A case={case} lane={lane}"
+                );
+                assert_eq!(got[2][lane], ub, "upper B case={case} lane={lane}");
+                assert_eq!(
+                    got[3][lane],
+                    original[3][lane] + ub,
+                    "lower B case={case} lane={lane}"
+                );
+            }
+        }
+    }
